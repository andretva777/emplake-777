rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada jogador tem um documento com pontuação e placas resolvidas.
    match /users/{uid} {
      // Qualquer usuário autenticado pode ler (necessário para o ranking).
      allow read: if request.auth != null;
      // Só o dono escreve no próprio documento.
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
